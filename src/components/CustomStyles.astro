<style is:inline>
  :root {
    color-scheme: light;
    --aw-font-sans: 'Inter', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --aw-font-heading: var(--aw-font-sans);
    --aw-font-serif: var(--aw-font-sans);
    /* DiffScope Light, from ColorSchemeCollection.cpp. */
    --aw-color-primary: #6b7aff;
    --aw-color-secondary: #5566ff;
    --aw-color-accent: #6b7aff;
    --aw-color-link: #4654ce;
    --aw-color-text-heading: #050608;
    --aw-color-text-default: #202226;
    --aw-color-text-muted: #626773;
    --aw-color-bg-page: #f4f5fa;
    --aw-color-bg-page-dark: #212124;
    --ds-surface: #f8faff;
    --ds-subtle: #eceef2;
    --ds-border: #dcdfe8;
    --ds-accent-soft: #e8eaff;
  }
  .dark {
    color-scheme: dark;
    /* DiffScope Dark. */
    --aw-color-primary: #5566ff;
    --aw-color-secondary: #6b7aff;
    --aw-color-accent: #5566ff;
    --aw-color-link: #9ba5ff;
    --aw-color-text-heading: #f4f5fa;
    --aw-color-text-default: #dadada;
    --aw-color-text-muted: #a8aab5;
    --aw-color-bg-page: #212124;
    --ds-surface: #252629;
    --ds-subtle: #232427;
    --ds-border: #343538;
    --ds-accent-soft: #2c3050;
  }
  ::selection {
    background: var(--ds-accent-soft);
    color: var(--aw-color-text-heading);
  }
</style>
