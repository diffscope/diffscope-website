import { Icon } from 'astro-icon/components';
import { dictionaries, localizePath, type Locale } from '~/i18n';
import { channels } from '~/utils/downloads.mjs';
interface Props {
  locale: Locale;
  compact?: boolean;
  lazy?: boolean;
}
const { locale, compact = false, lazy = false } = Astro.props;
const t = dictionaries[locale].ui;
const strings = dictionaries[locale];
const id = `channels-${crypto.randomUUID()}`;
---

<ds-download
  class:list={['download-control', { 'download-compact': compact }]}
  data-strings={JSON.stringify({ ui: t, downloads: strings.downloads })}
  data-page={localizePath('downloads', locale)}
  data-lazy={String(lazy)}
  data-compact={String(compact)}
>
  <div class="download-split">
    <button class="download-main" type="button" disabled={!lazy} data-download-main aria-busy={!lazy}>
      <Icon name="tabler:download" class="download-icon" />
      <span class="download-labels">
        <span data-download-label>{compact || lazy ? t.download : strings.downloads.loading}</span>
        <span class="download-subtitle" data-download-subtitle>{lazy ? strings.downloads.viewVersions : ''}</span>
      </span>
    </button>
    <details class="download-details" data-download-details>
      <summary aria-label={t.channels} aria-controls={id}>
        <Icon name="tabler:chevron-down" class="size-4" />
      </summary>
      <div id={id} class="download-popover">
        {
          channels.map((channel) => (
            <button type="button" class="channel-option" data-channel={channel} disabled>
              <span class="channel-name">{t[channel]}</span>
              <span class="channel-status">{strings.downloads.loading}</span>
            </button>
          ))
        }
      </div>
    </details>
  </div>
</ds-download>
<script>
  import '~/scripts/download-button';
</script>
